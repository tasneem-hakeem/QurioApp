<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Empty heart for background -->
    <item android:id="@android:id/background"
        android:drawable="@drawable/img_streak_empty" />
    <!-- Half heart for secondary progress (when the rating includes half hearts) -->
    <item android:id="@android:id/secondaryProgress"
        android:drawable="@drawable/img_streak_empty" />
    <!-- Full heart for progress -->
    <item android:id="@android:id/progress"
        android:drawableTint="@color/shade_primary"
        android:drawableTintMode="src_in"
        android:drawable="@drawable/img_streak" />
</layer-list>