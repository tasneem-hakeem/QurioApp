<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <View
        android:id="@+id/awards_container"
        android:layout_width="96dp"
        android:layout_height="50dp"
        android:background="@drawable/awards_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/awards_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/awards"
        android:textAppearance="@style/Label.XSmall"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="@id/awards_container"
        app:layout_constraintStart_toStartOf="@id/awards_container"
        app:layout_constraintTop_toTopOf="@id/awards_container" />

    <ImageView
        android:id="@+id/awards_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@string/icon_cup"
        android:src="@drawable/ic_cup"
        app:layout_constraintEnd_toStartOf="@+id/awards_count"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@id/awards_container"
        app:layout_constraintTop_toBottomOf="@id/awards_label" />

    <TextView
        android:id="@+id/awards_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="4dp"
        android:textAppearance="@style/Label.Medium"
        android:textColor="@color/shade_primary"
        app:layout_constraintBottom_toBottomOf="@id/awards_icon"
        app:layout_constraintEnd_toStartOf="@id/btn_upgrade_awards"
        app:layout_constraintStart_toEndOf="@+id/awards_icon"
        app:layout_constraintTop_toTopOf="@id/awards_icon"
        tools:text="2" />

    <ImageView
        android:id="@+id/btn_upgrade_awards"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/icon_arrow_right"
        android:src="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toBottomOf="@id/awards_icon"
        app:layout_constraintEnd_toEndOf="@id/awards_container"
        app:layout_constraintStart_toEndOf="@+id/awards_count"
        app:layout_constraintTop_toTopOf="@id/awards_icon" />

    <View
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="1dp"
        android:background="@drawable/top_rounded_bar"
        app:layout_constraintBottom_toBottomOf="@id/awards_container"
        app:layout_constraintEnd_toEndOf="@id/awards_container"
        app:layout_constraintStart_toStartOf="@id/awards_container" />

</androidx.constraintlayout.widget.ConstraintLayout>