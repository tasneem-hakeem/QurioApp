<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/lives_container"
        android:layout_width="96dp"
        android:layout_height="50dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/asymmetric_rectangle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/icon_plus"
        android:src="@drawable/ic_plus"
        app:layout_constraintStart_toStartOf="@+id/lives_container"
        app:layout_constraintTop_toTopOf="@+id/lives_container" />

    <TextView
        android:id="@+id/text_lives"
        style="@style/Label.XSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="@string/lives"
        android:textColor="@color/shade_tertiary"
        app:layout_constraintEnd_toEndOf="@+id/lives_container"
        app:layout_constraintStart_toStartOf="@+id/lives_container"
        app:layout_constraintTop_toTopOf="@+id/lives_container" />

    <TextView
        android:id="@+id/text_lives_value"
        style="@style/Label.Medium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text=""
        android:textAlignment="center"
        android:textColor="@color/shade_primary"
        app:drawableStartCompat="@drawable/ic_coin"
        app:layout_constraintBottom_toBottomOf="@+id/lives_container"
        app:layout_constraintEnd_toEndOf="@+id/lives_container"
        app:layout_constraintStart_toStartOf="@+id/lives_container"
        app:layout_constraintTop_toBottomOf="@+id/text_lives"
        tools:text="5" />

    <View
        android:id="@+id/top_rounded_bar"
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:background="@drawable/top_rounded_bar"
        app:layout_constraintBottom_toBottomOf="@+id/lives_container"
        app:layout_constraintEnd_toEndOf="@+id/lives_container"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
